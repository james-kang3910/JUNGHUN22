  const [myShopsLoading, setMyShopsLoading] = useState(false);

  const cats = useMemo(
    () => [
      { key: "all", label: "전체" },
      { key: "food", label: "음식" },
      { key: "cafe", label: "카페" },
      { key: "life", label: "생활" },
      { key: "beauty", label: "뷰티" },
      { key: "etc", label: "기타" },
    ],
    []
  );

  // 서버에서 데이터 로드
  useEffect(() => {
    loadShops();
    loadMyShops();
  }, []);

  const loadShops = async () => {
    try {
      setLoading(true);
      const data = (await storageAdapter.getShops()) || [];
      // Normalize id fields from different DB shapes (id | shopId | shop_id)
      const normalized = data.map((s) => ({ ...s, id: s.id || s.shopId || s.shop_id || s.shopId }));
      setShops(normalized);
    } catch (error) {
      console.error('[Shops] Failed to load shops:', error);
    } finally {
      setLoading(false);
    }
  };

