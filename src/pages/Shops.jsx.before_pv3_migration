                    {isMyShop && (
                      <span style={{ 
                        fontSize: 11, 
                        padding: "2px 6px", 
                        borderRadius: 4, 
                        background: "rgba(99,102,241,0.8)", 
                        color: "#fff",
                        fontWeight: 700,
                      }}>
                        내 가게
                      </span>
                    )}
                  </div>
                  <div style={{ display: "flex", gap: 6, alignItems: "center" }}>
                    {isPending ? (
                      <span style={{ ...badgeStyle, background: "rgba(255,165,0,0.2)", color: "#ffa500" }}>대기중</span>
                    ) : (
                      <span style={badgeStyle}>{s.badge}</span>
                    )}
                    <span style={{ fontSize: 12, opacity: 0.8 }}>⭐ {s.score}</span>
                  </div>
                </div>

                <div style={{ marginTop: 6, fontSize: 13, opacity: 0.85 }}>{s.sub}</div>

                <div style={{ marginTop: 8, display: "flex", justifyContent: "space-between", gap: 10, fontSize: 12, opacity: 0.8 }}>
                  <span>거리 {s.dist}</span>
                  <span style={{ padding: "3px 8px", borderRadius: 999, border: "1px solid rgba(255,255,255,0.10)" }}>
                    {catLabel(s.cat)}
                  </span>
                </div>

                {/* 이미지/썸네일 영역: 승인 상태에 따라 분기 */}
                <div
                  style={{
                    marginTop: 10,
                    height: 92,
                    borderRadius: 12,
                    border: isPending ? "1px dashed rgba(255,165,0,0.4)" : "1px dashed rgba(255,255,255,0.18)",
                    background: isPending ? "rgba(255,165,0,0.05)" : "transparent",
                    display: "flex",
                    alignItems: "center",
                    justifyContent: "center",
                    opacity: 0.7,
                    fontSize: 12,
                  }}
                >
                  {isPending ? (
                    <span style={{ color: "#ffa500", fontWeight: 700 }}>🔒 등록준비중</span>
                  ) : s.image ? (
                    <img src={s.image} alt={s.name} style={{ width: "100%", height: "100%", objectFit: "cover", borderRadius: 12 }} />
                  ) : (
                    <span>이미지/썸네일 영역(추후)</span>
                  )}
                </div>
              </button>
            );
          })}

          {filtered.length === 0 && (
            <div style={{ ...cardStyle, opacity: 0.85 }}>
              조건에 맞는 상점이 없어요. (카테고리/검색어를 바꿔보세요)
            </div>
          )}
          </div>
        )}

        <button
          type="button"
          className="su-primaryBtn"
          style={{ marginTop: 12, width: "100%" }}
          onClick={() => window.alert("리스트 더보기(추후 연결)")}
        >
          더보기
        </button>
      </section>

      {/* ★ 4. 혜택/VIP 배너 (하단 부가 정보) */}
      <section style={panelStyle}>
        <div style={{ display: "flex", justifyContent: "space-between", gap: 10, alignItems: "center" }}>
          <div style={{ fontWeight: 900 }}>🎁 혜택 / VIP</div>
          <button
            type="button"
            className="su-pill"
            onClick={() => window.alert("혜택 상세(추후 연결)")}
            style={{ padding: "8px 10px" }}
          >
            더보기 →
          </button>
        </div>

        <div
          style={{
            marginTop: 10,
            borderRadius: 14,
            border: "1px solid rgba(255,255,255,0.10)",
            background: "rgba(255,255,255,0.06)",
            padding: 12,
          }}
        >
          <div style={{ fontWeight: 900 }}>이번 주 추천 혜택</div>
          <div style={{ marginTop: 6, fontSize: 13, opacity: 0.85, lineHeight: 1.5 }}>
            • 제휴 상점 방문 시 포인트 적립<br />
            • VIP 쿠폰(테스트) 배포 예정<br />
            • 참여 밋션 완료 시 추가 혜택
          </div>
        </div>
      </section>

      <div style={{ height: 90 }} />

      {/* ★ 상가 선택 모달 (다수 소유 시) */}
      {showShopPicker && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            zIndex: 9999,
            background: "rgba(0,0,0,0.7)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 16,
          }}
          onClick={() => setShowShopPicker(false)}
        >
          <div
            style={{
              background: "#1a1a2e",
              borderRadius: 16,
              width: "100%",
              maxWidth: 400,
              maxHeight: "70vh",
              overflowY: "auto",
              padding: 20,
              border: "1px solid rgba(99,102,241,0.3)",
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <h3 style={{ margin: "0 0 16px", fontSize: 18, fontWeight: 900, textAlign: "center" }}>
              수정할 상가를 선택하세요
            </h3>

            <div style={{ display: "grid", gap: 10 }}>
              {myShops.map((shop) => (
                <button
                  key={shop.id}
                  type="button"
                  onClick={() => openEditModal(shop)}
                  style={{
                    padding: 14,
                    borderRadius: 12,
                    border: "1px solid rgba(99,102,241,0.4)",
                    background: "rgba(99,102,241,0.1)",
                    textAlign: "left",
                    cursor: "pointer",
                    transition: "all 0.2s",
                  }}
                  onMouseEnter={(e) => {
                    e.currentTarget.style.background = "rgba(99,102,241,0.2)";
                    e.currentTarget.style.borderColor = "rgba(99,102,241,0.6)";
                  }}
                  onMouseLeave={(e) => {
                    e.currentTarget.style.background = "rgba(99,102,241,0.1)";
                    e.currentTarget.style.borderColor = "rgba(99,102,241,0.4)";
                  }}
                >
                  <div style={{ fontWeight: 900, fontSize: 15 }}>{shop.name}</div>
                  <div style={{ marginTop: 4, fontSize: 13, opacity: 0.8 }}>{shop.sub}</div>
                  <div style={{ marginTop: 6, fontSize: 12, opacity: 0.6 }}>
                    {catLabel(shop.cat)} · {shop.status === "pending" ? "승인대기" : "승인완료"}
                  </div>
                </button>
              ))}
            </div>

            <button
              type="button"
              onClick={() => setShowShopPicker(false)}
              style={{
                marginTop: 16,
                width: "100%",
                padding: "12px",
                borderRadius: 10,
                border: "1px solid rgba(255,255,255,0.1)",
                background: "transparent",
                color: "#fff",
                fontWeight: 700,
                cursor: "pointer",
              }}
            >
              취소
            </button>
          </div>
        </div>
      )}

      {/* ★ 수정 모달 */}
      {showEditModal && editingShop && (
        <ShopEditModal
          shop={editingShop}
          onClose={() => setShowEditModal(false)}
          onSaved={async () => {
            await loadShops();
            await loadMyShops();
          }}
        />
      )}

      {/* ★ 상점 등록 모달 */}
      {showModal && (
        <div
          style={{
            position: "fixed",
            inset: 0,
            zIndex: 9999,
            background: "rgba(0,0,0,0.7)",
            display: "flex",
            alignItems: "center",
            justifyContent: "center",
            padding: 16,
          }}
          onClick={handleModalClose}
        >
          <div
            style={{
              background: "#1a1a2e",
              borderRadius: 16,
              width: "100%",
              maxWidth: 400,
              maxHeight: "85vh",
              overflowY: "auto",
              padding: 20,
              border: "1px solid rgba(255,255,255,0.1)",
            }}
            onClick={(e) => e.stopPropagation()}
          >
            <h3 style={{ margin: "0 0 16px", fontSize: 18, fontWeight: 900, textAlign: "center" }}>
              🏪 상점 등록
            </h3>

            {/* 에러 메시지 */}
            {formError && (
              <div style={{
                background: "rgba(239,68,68,0.15)",
                border: "1px solid rgba(239,68,68,0.3)",
                borderRadius: 8,
                padding: "10px 12px",
                marginBottom: 12,
                color: "#ef4444",
                fontSize: 13,
                fontWeight: 600,
              }}>
                {formError}
              </div>
            )}

            {/* 상점명 (필수) */}
            <div style={{ marginBottom: 12 }}>
              <label style={{ display: "block", marginBottom: 4, fontSize: 13, fontWeight: 700 }}>
                상점명 <span style={{ color: "#ef4444" }}>*</span>
              </label>
              <input
                type="text"
                value={regForm.name}
                onChange={handleRegFormChange("name")}
                placeholder="상점명을 입력하세요"
                style={{
                  width: "100%",
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(255,255,255,0.1)",
                  background: "rgba(0,0,0,0.2)",
                  color: "#fff",
                  outline: "none",
                }}
              />
            </div>

            {/* 업종 (필수) */}
            <div style={{ marginBottom: 12 }}>
              <label style={{ display: "block", marginBottom: 4, fontSize: 13, fontWeight: 700 }}>
                업종 <span style={{ color: "#ef4444" }}>*</span>
              </label>
              <select
                value={regForm.category}
                onChange={handleRegFormChange("category")}
                style={{
                  width: "100%",
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(255,255,255,0.1)",
                  background: "rgba(0,0,0,0.2)",
                  color: "#fff",
                  outline: "none",
                }}
              >
                <option value="food">음식</option>
                <option value="cafe">카페</option>
                <option value="life">생활</option>
                <option value="beauty">뷰티</option>
                <option value="etc">기타</option>
              </select>
            </div>

            {/* 한줄 소개 (선택) */}
            <div style={{ marginBottom: 12 }}>
              <label style={{ display: "block", marginBottom: 4, fontSize: 13, fontWeight: 700 }}>
                한줄 소개
              </label>
              <input
                type="text"
                value={regForm.sub}
                onChange={handleRegFormChange("sub")}
                placeholder="간단한 소개 (선택)"
                style={{
                  width: "100%",
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(255,255,255,0.1)",
                  background: "rgba(0,0,0,0.2)",
                  color: "#fff",
                  outline: "none",
                }}
              />
            </div>

            {/* 대표자 이름 (필수) */}
            <div style={{ marginBottom: 12 }}>
              <label style={{ display: "block", marginBottom: 4, fontSize: 13, fontWeight: 700 }}>
                대표자 이름 <span style={{ color: "#ef4444" }}>*</span>
              </label>
              <input
                type="text"
                value={regForm.ownerName}
                onChange={handleRegFormChange("ownerName")}
                placeholder="대표자 이름"
                style={{
                  width: "100%",
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(255,255,255,0.1)",
                  background: "rgba(0,0,0,0.2)",
                  color: "#fff",
                  outline: "none",
                }}
              />
            </div>

            {/* 대표자 전화번호 (필수) */}
            <div style={{ marginBottom: 12 }}>
              <label style={{ display: "block", marginBottom: 4, fontSize: 13, fontWeight: 700 }}>
                대표자 전화번호 <span style={{ color: "#ef4444" }}>*</span>
              </label>
              <input
                type="tel"
                value={regForm.ownerPhone}
                onChange={handleRegFormChange("ownerPhone")}
                placeholder="010-1234-5678"
                style={{
                  width: "100%",
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px solid rgba(255,255,255,0.1)",
                  background: "rgba(0,0,0,0.2)",
                  color: "#fff",
                  outline: "none",
                }}
              />
            </div>

            {/* 사진 등록 (선택) */}
            <div style={{ marginBottom: 16 }}>
              <label style={{ display: "block", marginBottom: 4, fontSize: 13, fontWeight: 700 }}>
                상점 사진 (선택)
              </label>
              <input
                ref={photoInputRef}
                type="file"
                accept="image/*"
                onChange={handlePhotoChange}
                style={{ display: "none" }}
              />
              <button
                type="button"
                onClick={() => photoInputRef.current?.click()}
                style={{
                  width: "100%",
                  padding: "10px 12px",
                  borderRadius: 10,
                  border: "1px dashed rgba(255,255,255,0.2)",
                  background: "rgba(0,0,0,0.1)",
                  color: "rgba(255,255,255,0.7)",
                  cursor: "pointer",
                }}
              >
                📷 사진 업로드
              </button>

              {/* 사진 미리보기 */}
              {regForm.photoPreviewUrl && (
                <div style={{ marginTop: 10, position: "relative" }}>
                  <img
                    src={regForm.photoPreviewUrl}
                    alt="미리보기"
                    style={{
                      width: "100%",
                      height: 120,
                      objectFit: "cover",
                      borderRadius: 10,
                      border: "1px solid rgba(255,255,255,0.1)",
                    }}
                  />
                  <button
                    type="button"
                    onClick={() => {
                      URL.revokeObjectURL(regForm.photoPreviewUrl);
                      setRegForm((prev) => ({ ...prev, photoFile: null, photoPreviewUrl: null }));
                    }}
                    style={{
                      position: "absolute",
                      top: 6,
                      right: 6,
                      width: 24,
                      height: 24,
                      borderRadius: "50%",
                      background: "rgba(0,0,0,0.7)",
                      border: "none",
                      color: "#fff",
                      cursor: "pointer",
                      fontSize: 14,
                    }}
                  >
                    ✕
                  </button>
                </div>
              )}
            </div>

            {/* 안내 문구 */}
            <div style={{
              background: "rgba(99,102,241,0.1)",
              borderRadius: 8,
              padding: 10,
              marginBottom: 16,
              fontSize: 12,
              color: "rgba(255,255,255,0.7)",
              lineHeight: 1.5,
            }}>
              ℹ️ 등록 후 관리자 승인을 거쳐 상점이 공개됩니다.<br />
              승인 전까지 상점 상세 진입이 제한됩니다.
            </div>

            {/* 버튼 */}
            <div style={{ display: "flex", gap: 10 }}>
              <button
                type="button"
                onClick={handleModalClose}
                style={{
                  flex: 1,
                  padding: "12px",
                  borderRadius: 10,
                  border: "1px solid rgba(255,255,255,0.1)",
                  background: "transparent",
                  color: "#fff",
                  fontWeight: 700,
                  cursor: "pointer",
                }}
              >
                취소
              </button>
              <button
                type="button"
                onClick={handleRegisterSubmit}
                style={{
                  flex: 1,
                  padding: "12px",
                  borderRadius: 10,
                  border: "none",
                  background: "linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)",
                  color: "#fff",
                  fontWeight: 700,
                  cursor: "pointer",
                }}
              >
                등록하기
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

function catLabel(c) {
  if (c === "food") return "음식";
  if (c === "cafe") return "카페";
  if (c === "life") return "생활";
  if (c === "beauty") return "뷰티";
  return "기타";
}
