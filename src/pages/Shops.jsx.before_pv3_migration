  // ★ 서버 데이터 + 정적 상점 병합 (서버 데이터가 먼저)
  const allShops = useMemo(() => [...shops, ...staticShops], [shops, staticShops]);

  // ★ 내 상가 ID 목록 (서버에서 가져온 myShops 기준)
  const myShopIds = useMemo(() => {
    return myShops.map(s => s.id || s.shopId);
  }, [myShops]);

  // ★ 다른 상가
  const otherShops = useMemo(() => {
    return allShops.filter(s => !myShopIds.includes(s.id));
  }, [allShops, myShopIds]);

  // ★ 내 상가를 최상단에 배치
  const sortedShops = useMemo(() => {
    return [...myShops, ...otherShops];
  }, [myShops, otherShops]);

  const filtered = useMemo(() => {
    const qq = String(q || "").trim().toLowerCase();
    return sortedShops.filter((s) => {
      const okCat = cat === "all" ? true : s.cat === cat;
      const okQ = !qq ? true : (s.name + " " + s.sub).toLowerCase().includes(qq);
      return okCat && okQ;
    });
  }, [sortedShops, cat, q]);

  // ★ 상점 등록 핸들러
  const handleRegFormChange = (field) => (e) => {
    setRegForm((prev) => ({ ...prev, [field]: e.target.value }));
    setFormError("");
  };

  const handlePhotoChange = (e) => {
    const file = e.target.files?.[0];
    if (file) {
      const previewUrl = URL.createObjectURL(file);
      setRegForm((prev) => ({ ...prev, photoFile: file, photoPreviewUrl: previewUrl }));
    }
  };

  const validatePhone = (phone) => {
    // 숫자와 하이픈만 허용, 최소 9자리
    const cleaned = phone.replace(/[^0-9-]/g, "");
    return cleaned.length >= 9 && /^[0-9-]+$/.test(phone);
  };

  const handleRegisterSubmit = async () => {
    // 유효성 검사
    if (!regForm.name.trim()) {
      setFormError("상점명을 입력해주세요.");
      return;
    }
    if (!regForm.category) {
      setFormError("업종을 선택해주세요.");
      return;
    }
    if (!regForm.ownerName.trim()) {
      setFormError("대표자 이름을 입력해주세요.");
      return;
    }
    if (!regForm.ownerPhone.trim()) {
      setFormError("대표자 전화번호를 입력해주세요.");
      return;
    }
    if (!validatePhone(regForm.ownerPhone)) {
      setFormError("전화번호 형식이 올바르지 않습니다. (예: 010-1234-5678)");
      return;
    }

    try {
      const auth = getAuthInfo();
      const memberId = auth?.memberId;
      
      // 새 상점 객체 생성
      const newShop = {
        name: regForm.name.trim(),
        category: regForm.category,
        sub: regForm.sub.trim() || "새로 등록된 상점",
        status: "pending", // ★ 필수: 등록 시 pending
        ownerName: regForm.ownerName.trim(),
        ownerPhone: regForm.ownerPhone.trim(),
        // photoFile은 별도 업로드 필요 (추후 구현)
      };

      // 서버에 저장
      await storageAdapter.upsertShop(newShop, memberId);

      // 리스트 새로고침
      await loadShops();
      await loadMyShops();

      // 모달 닫기 및 폼 초기화
      setShowModal(false);
      setRegForm({
        name: "",
        category: "food",
        sub: "",
        ownerName: "",
        ownerPhone: "",
        photoFile: null,
        photoPreviewUrl: null,
      });
      setFormError("");

      // 완료 알림
      window.alert("등록 완료(승인 대기중)");
    } catch (error) {
      console.error('[handleRegisterSubmit] Error:', error);
      setFormError(error.message || '등록 중 오류가 발생했습니다.');
    }
  };

  const handleModalClose = () => {
    setShowModal(false);
    setFormError("");
    // photoPreviewUrl 해제
    if (regForm.photoPreviewUrl) {
      URL.revokeObjectURL(regForm.photoPreviewUrl);
    }
    setRegForm({
      name: "",
      category: "food",
      sub: "",
      ownerName: "",
      ownerPhone: "",
      photoFile: null,
      photoPreviewUrl: null,
    });
  };

  // ★ 수정 CTA 클릭 핸들러
  const handleEditCtaClick = () => {
    if (myShops.length === 0) return;

    if (myShops.length === 1) {
      // 소유 상가 1개: 즉시 수정 모달 오픈
      openEditModal(myShops[0]);
    } else {
      // 소유 상가 다수: 선택 UI 표시
      setShowShopPicker(true);
    }
  };

  // ★ 수정 모달 열기
  const openEditModal = (shop) => {
    setEditingShop(shop);
    setShowEditModal(true);
    setShowShopPicker(false);
  };

  // ★ 수정 저장 (임시 - 실제 구현은 ShopEditModal에서)
  const handleEditSave = async (updatedData) => {
    try {
      // TODO: await storageAdapter.upsertShop({ ...updatedData, id: editingShop.id });
      setShowEditModal(false);
      await loadShops();
      window.alert('상점 정보가 수정되었습니다.');
    } catch (error) {
      console.error('[handleEditSave] Error:', error);
      window.alert('수정 실패: ' + error.message);
    }
  };

