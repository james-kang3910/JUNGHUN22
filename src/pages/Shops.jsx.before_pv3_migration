    try {
      const auth = getAuthInfo();
      if (!auth || !auth.memberId) {
        console.log('[Shops] No auth, skipping my shops load');
        setMyShops([]);
        return;
      }
      
      setMyShopsLoading(true);
      const data = (await storageAdapter.getMyShops(auth.memberId)) || [];
