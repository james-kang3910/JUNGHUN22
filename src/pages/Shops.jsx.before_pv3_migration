                type="button"
                style={{
                  ...cardStyle,
                  opacity: isPending ? 0.7 : 1,
                  cursor: isPending ? "not-allowed" : "pointer",
                  border: isMyShop ? "2px solid rgba(99,102,241,0.6)" : cardStyle.border,
                  background: isMyShop ? "linear-gradient(135deg, rgba(99,102,241,0.15), rgba(139,92,246,0.1))" : cardStyle.background,
