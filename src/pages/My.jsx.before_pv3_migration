            <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
              <span style={{ fontSize: 13 }}>공유 알림</span>
              <button type="button" onClick={toggleChatSound} style={{ padding: '4px 8px', borderRadius: 999, background: chatSoundEnabled ? 'rgba(110,231,183,0.16)' : 'rgba(255,255,255,0.06)', color: chatSoundEnabled ? '#10b981' : 'rgba(255,255,255,0.6)', fontWeight: 700, fontSize: 12, border: 'none', cursor: 'pointer' }}>{chatSoundEnabled ? 'ON' : 'OFF'}</button>
            </div>
          </div>
          <div style={{ flex: 1, overflowY: 'auto', padding: 8, borderRadius: 8, background: '#071023', marginBottom: 8 }}>
            {(chatMessages || []).map(m => (
              <div key={m.id} style={{ marginBottom: 8, textAlign: m.from === String(currentUserId) ? 'right' : 'left' }}>
                <div style={{ display: 'inline-block', padding: '8px 12px', borderRadius: 8, background: m.from === String(currentUserId) ? '#6ee7b7' : '#1f2937', color: m.from === String(currentUserId) ? '#000' : '#fff', maxWidth: '70%', wordWrap: 'break-word' }}>{m.text}</div>
                <div style={{ fontSize: 11, opacity: 0.6, marginTop: 4 }}>{new Date(m.createdAt).toLocaleString()}</div>
              </div>
            ))}
          </div>
          <div style={{ display: 'flex', gap: 8 }}>
            <input id="chat-input" placeholder="메시지 입력" style={{ flex: 1, padding: 8, borderRadius: 8, background: 'rgba(255,255,255,0.05)', border: '1px solid rgba(255,255,255,0.1)', color: '#fff' }} onKeyDown={(e) => { if (e.key === 'Enter') { const el = e.target; const text = el.value?.trim(); if (text) { sendChatMessage(text); el.value = ''; } } }} />
            <button type="button" onClick={() => {
              const el = document.getElementById('chat-input');
              if (!el) return; const text = el.value && el.value.trim(); if (!text) return; sendChatMessage(text); el.value = '';
            }} style={{ padding: '8px 16px', borderRadius: 8, background: '#60a5fa', color: '#fff', border: 'none', cursor: 'pointer', fontWeight: 700 }}>전송</button>
            <button type="button" onClick={() => { setChatOpen(false); setActiveChatFriend(null); setChatMessages([]); }} style={{ padding: '8px 16px', borderRadius: 8, background: 'transparent', border: '1px solid rgba(255,255,255,0.06)', color: '#fff', cursor: 'pointer' }}>닫기</button>
          </div>
        </div>
      </div>
    )}

    <Toast 
      open={toast.open}
      message={toast.message}
      type={toast.type}
      onClose={() => setToast(prev => ({ ...prev, open: false }))}
      duration={3000}
    />
    </div>
  );
}
