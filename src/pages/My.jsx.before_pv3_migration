      { id: 2, item: "이벤트 굿즈", status: "배송중", date: "2026-01-18" },
    ],
    purchases: [
      { id: 1, item: "공유국밥", amount: 9000, status: "완료", date: "2026-01-19" },
      { id: 2, item: "동네카페 라떼", amount: 5500, status: "완료", date: "2026-01-16" },
    ],
  });

  // ★ 상점 데이터 - 서버 API 연동 (pv3 기능)
  const [myShops, setMyShops] = useState([]);
  const [shopModalOpen, setShopModalOpen] = useState(false);
  const [editingShop, setEditingShop] = useState(null);
  const [shopForm, setShopForm] = useState({
    name: '',
    address: '',
    phone: '',
    description: '',
    category: '',
  });

  // 내 상점 목록 로드
  useEffect(() => {
    let mounted = true;
