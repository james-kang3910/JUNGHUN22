      console.error('[My] Failed to delete shop:', e);
      setToast({ open: true, message: '삭제 실패', type: 'error' });
    }
  };

  // ★ 친구 데이터 - 서버 API 연동
  const [friends, setFriends] = useState([]);
  const [friendData, setFriendData] = useState({ count: 0, list: [] });
  const [friendModalOpen, setFriendModalOpen] = useState(false);
  const [friendCandidates, setFriendCandidates] = useState([]);
  
  // ★ 채팅 상태 (pv2 패턴)
  const [chatOpen, setChatOpen] = useState(false);
  const [activeChatFriend, setActiveChatFriend] = useState(null);
  const [chatMessages, setChatMessages] = useState([]);
  const [chatSoundEnabled, setChatSoundEnabled] = useState(true);

  useEffect(() => {
    try {
      const v = localStorage.getItem('su_chat_sound_enabled');
      setChatSoundEnabled(v === null ? true : v !== '0');
    } catch (e) { setChatSoundEnabled(true); }
  }, []);

  const toggleChatSound = () => {
    try {
      const next = !chatSoundEnabled;
      setChatSoundEnabled(next);
      localStorage.setItem('su_chat_sound_enabled', next ? '1' : '0');
    } catch (e) {}
  };
  
  useEffect(() => {
    let mounted = true;
    async function loadFriends() {
      if (!currentUserId) {
        setFriendData({ count: 0, list: [] });
        setFriends([]);
        return;
      }
      try {
        const friendIds = await friendService.getFriends(currentUserId);
        const members = getMembers() || [];
        const friendsList = friendIds.map(fid => {
          const member = members.find(m => (m.id === fid || m.memberId === fid));
          return member ? { 
            id: member.id || member.memberId, 
            name: member.name || member.nickname, 
            joinDate: member.createdAt?.split('T')[0] || '-'
          } : { id: fid, name: '사용자', joinDate: '-' };
        });
        
        if (mounted) {
          setFriendData({ count: friendsList.length, list: friendsList });
          setFriends(friendsList);
        }
      } catch (e) {
        console.error('[My] Failed to load friends:', e);
        if (mounted) {
          setFriendData({ count: 0, list: [] });
          setFriends([]);
        }
      }
    }
    loadFriends();
    
    const onUpdate = () => { loadFriends(); };
    window.addEventListener('su:ssot:changed', onUpdate);
    window.addEventListener('su_friends:updated', onUpdate);
    return () => { 
      mounted = false; 
      window.removeEventListener('su:ssot:changed', onUpdate);
      window.removeEventListener('su_friends:updated', onUpdate);
    };
  }, [currentUserId]);

  // ★ 친구 추가 모달 열기 (pv2 패턴)
  const openFriendModal = () => {
    try {
      const members = getMembers() || [];
      const myId = String(currentUserId || userData?.id || userData?.memberId || 'guest');
      const myFriendIds = (friends || []).map(f => String(f.id));
      const candidates = members.filter(m => 
        String(m.id || m.memberId) !== myId && 
        !myFriendIds.includes(String(m.id || m.memberId))
      );
      setFriendCandidates(candidates);
      setFriendModalOpen(true);
    } catch (e) { 
      setFriendCandidates([]); 
      setFriendModalOpen(true); 
    }
  };

  const handleAddFriend = async (member) => {
    try {
      await friendService.addFriend(currentUserId, member.id || member.memberId);
      // 양방향 친구 관계 설정
      try { await friendService.addFriend(member.id || member.memberId, currentUserId); } catch (e) {}
      setFriendCandidates(prev => prev.filter(p => String(p.id || p.memberId) !== String(member.id || member.memberId)));
      setToast({ open: true, message: `${member.name}님을 친구로 추가했습니다`, type: 'success' });
    } catch (e) {
      setToast({ open: true, message: '친구 추가 실패', type: 'error' });
    }
  };

  const handleRemoveFriend = async (member) => {
    if (!window.confirm(`${member.name}님을 친구 목록에서 삭제하시겠습니까?`)) return;
    try {
      await friendService.removeFriend(currentUserId, member.id || member.memberId);
      try { await friendService.removeFriend(member.id || member.memberId, currentUserId); } catch (e) {}
      setToast({ open: true, message: '친구가 삭제되었습니다', type: 'success' });
    } catch (e) {
      setToast({ open: true, message: '친구 삭제 실패', type: 'error' });
    }
  };

  const openChatWith = async (member) => {
    setActiveChatFriend(member);
    try {
      const to = member.id || member.memberId;
      const res = await storageAdapter.fetchChats(currentUserId, to);
      setChatMessages(res.messages || []);
    } catch (e) {
      console.error('[My] Failed to load chat messages:', e);
      setChatMessages([]);
    }
    setChatOpen(true);
  };

  const sendChatMessage = async (text) => {
    if (!activeChatFriend || !text || !text.trim()) return;
    try {
      const to = activeChatFriend.id || activeChatFriend.memberId;
      const res = await storageAdapter.sendChatMessage(currentUserId, to, text.trim());
      if (res.success && res.message) {
        setChatMessages(prev => [...prev, res.message]);
        setToast({ open: true, message: '메시지를 전송했습니다', type: 'success' });
      }
    } catch (e) {
      console.error('[My] Failed to send message:', e);
      setToast({ open: true, message: '메시지 전송 실패', type: 'error' });
    }
  };

  const [assistantData] = useState({
    interestRegions: ["강남구", "서초구"],
    interestCategories: ["맛집", "카페", "이벤트"],
    notifications: {
      mission: true,
      event: true,
      point: false,
    },
    recentActivity: {
      missions: ["공유방송 시청", "리뷰 작성", "출석체크"],
      shops: ["공유국밥", "동네카페 라떼", "뷰티살롱 S"],
      recommendations: ["이번주 HOT 밋션", "신규 상점 추천", "포인트 2배 이벤트"],
    },
  });

  // ★ 관리자 여부 상태
  const [isAdmin, setIsAdmin] = useState(false);
  useEffect(() => {
    setIsAdmin(checkIsAdmin());
  }, []);

  // ★ 보급지원 담당자 여부 확인
  const [isSupplyManager, setIsSupplyManager] = useState(false);
  const [offers, setOffers] = useState([]);
  const [mySupplyRequests, setMySupplyRequests] = useState([]);

  useEffect(() => {
    let mounted = true;
    
    // supplyManager 플래그 확인 (로컬 -> 서버 페일백) 및 SSOT 변경 감시
    async function checkSupplyManager() {
      try {
        let isManager = false;
        let currentMember = null;
        if (currentUserId) {
          try {
            // Server is source-of-truth for role/supplyManager
            const serverMember = await storageAdapter.getMemberById(currentUserId);
            if (serverMember) {
              currentMember = serverMember;
              isManager = !!(serverMember.supplyManager || serverMember.supply_manager || serverMember.role === 'SUPPLY_MANAGER');
            }
          } catch (e) {
            // Fallback to local only if server unreachable
            const members = getMembers() || [];
            currentMember = members.find(m => (m.id === currentUserId || m.memberId === currentUserId));
            isManager = !!(currentMember && currentMember.supplyManager);
          }
        }
        console.log('[My.jsx] isSupplyManager check:', { currentUserId, currentMember, isManager });
