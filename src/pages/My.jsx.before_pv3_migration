        setToast({ open: true, message: '현재 포인트 전송이 중지되어 결제가 불가합니다.', type: 'warning' });
        return;
      }
      
      // Try server payment first
      try {
        const res = await fetch('/api/points/pay', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${currentUserId}`
          },
          body: JSON.stringify({ storeId, amount })
        });
        
        if (res.ok) {
          setToast({ open: true, message: '결제처리가 완료되었습니다.', type: 'success' });
          // Reload points
          const balanceRes = await getPointBalance(currentUserId);
          const historyRes = await getPointHistory(currentUserId, { limit: 50 });
          setPointData({ 
            balance: balanceRes.balance || 0, 
            history: historyRes.history || [] 
          });
          return;
        }
      } catch (serverError) {
        console.warn('[My] Server payment failed, falling back to localStorage', serverError);
      }
      
      // Fallback to localStorage (pv2 pattern)
      try {
        const key = 'su_pending_payments';
        const pending = JSON.parse(localStorage.getItem(key) || '[]');
        pending.push({
          id: `pay_${Date.now()}_${Math.random().toString(36).slice(2)}`,
          userId: currentUserId,
          storeId,
          amount,
          createdAt: new Date().toISOString(),
          status: 'pending'
        });
        localStorage.setItem(key, JSON.stringify(pending));
        setToast({ open: true, message: '결제 정보가 저장되었습니다. 서버 복구 시 자동 처리됩니다.', type: 'info' });
      } catch (localError) {
        console.error('[My] localStorage fallback failed', localError);
        setToast({ open: true, message: '결제 처리 중 오류가 발생했습니다.', type: 'error' });
      }
    } catch (e) {
      console.error('[My] Payment failed:', e);
      setToast({ open: true, message: '결제 처리 중 오류가 발생했습니다.', type: 'error' });
    }
  };
  
