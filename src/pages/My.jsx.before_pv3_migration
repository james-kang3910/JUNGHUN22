// ★ 관리자 여부 확인 함수
function checkIsAdmin() {
  try {
    if (localStorage.getItem("isAdmin") === "true") {
      return true;
    }
    const userStr = localStorage.getItem("su_auth_v2");
    if (userStr) {
      const user = JSON.parse(userStr);
      if (user.role === "admin") {
        return true;
      }
    }
    return false;
  } catch (e) {
    return false;
  }
}

function formatNumber(n) {
  try {
    return Number(n).toLocaleString();
  } catch (e) {
    return String(n);
  }
}

export default function My() {
  const navigate = useNavigate();

  // ★ 비로그인 시 로그인 페이지로 리다이렉트 (returnTo 포함)
  useEffect(() => {
    if (!isLoggedIn()) {
      navigate("/auth", { replace: true, state: { returnTo: "/my" } });
    }
  }, [navigate]);

  // 로그인 체크 중 렌더링 방지
  if (!isLoggedIn()) {
    return null;
  }

  // ────────── 3-tier userData fallback (pv2 pattern) ──────────
  // 1) getAuthInfo() 시도 → 2) getSession() + getMembers() → 3) null
  const getUserData = useCallback(() => {
    try {
      const auth = getAuthInfo();
      if (auth) return auth;

      const session = getSession();
      const members = getMembers();
      const memberId = session?.memberId || session?.id || null;
      if (memberId && Array.isArray(members)) {
        return members.find(m => m.id === memberId || m.memberId === memberId) || null;
      }
    } catch (e) {
      console.error('[My] getUserData error:', e);
    }
    return null;
  }, []);

  const [userData, setUserData] = useState(getUserData());

  // Toast state (pv2 UX pattern)
  const [toast, setToast] = useState({ open: false, message: '', type: 'success' });

  // Point history tab filter (pv2 UX)
  const [pointTabState, setPointTabState] = useState('all'); // 'all' | 'earn' | 'spend'

  // Schedule alarm system (pv2 UX)
  const [alarmsEnabled, setAlarmsEnabled] = useState(() => {
    try { return localStorage.getItem('su_schedule_alarms_enabled') !== 'false'; } catch (e) { return true; }
  });
  const alarmTimersRef = useRef({});

  // Supply status filter (pv3 UX)
  const [supplyStatusFilter, setSupplyStatusFilter] = useState('all'); // 'all' | 'pending' | 'approved' | 'completed'

  // userData refresh on storage/SSOT events (pv2 pattern)
  useEffect(() => {
    const refreshUserData = () => {
      const oldData = userData;
      const newData = getUserData();
      setUserData(newData);
      
      // Show Toast when permissions change (pv2 UX)
      if (oldData && newData) {
        if (!oldData.supplyManager && newData.supplyManager) {
          setToast({ open: true, message: '보급지원담당자 권한이 부여되었습니다', type: 'success' });
        }
        if (oldData.supplyManager && !newData.supplyManager) {
          setToast({ open: true, message: '보급지원담당자 권한이 해제되었습니다', type: 'warning' });
        }
      }
    };

    window.addEventListener('su:ssot:changed', refreshUserData);
    window.addEventListener('storage', refreshUserData);
    
    return () => {
      window.removeEventListener('su:ssot:changed', refreshUserData);
      window.removeEventListener('storage', refreshUserData);
    };
  }, [getUserData, userData]);

  // ★ 포인트 데이터 - 서버 API 연동
  const currentUserId = userData?.id || userData?.memberId || null;
  
  const [pointData, setPointData] = useState({
    balance: 0,
    history: [],
  });

  // Convenience alias for template usage
  const balance = pointData.balance || 0;

  // Filtered point history based on tab (pv2 pattern)
  const filteredHistory = useMemo(() => {
    const raw = pointData.history || [];
    if (pointTabState === 'earn') return raw.filter(h => (h.amount || 0) > 0 && h.status !== 'cancelled');
    if (pointTabState === 'spend') return raw.filter(h => (h.amount || 0) < 0 && h.status !== 'cancelled');
    return raw.filter(h => h.status !== 'cancelled');
  }, [pointData.history, pointTabState]);

  // 포인트 데이터 로드 (서버 API)
  useEffect(() => {
    let mounted = true;
    async function loadPoints() {
      if (!currentUserId) {
        setPointData({ balance: 0, history: [] });
        return;
      }
      try {
        const balanceRes = await getPointBalance(currentUserId);
        const historyRes = await getPointHistory(currentUserId, { limit: 50 });
        if (mounted) {
          setPointData({ 
            balance: balanceRes.balance || 0, 
            history: historyRes.history || [] 
          });
        }
      } catch (e) {
        console.error("[My] Failed to load points:", e);
        if (mounted) setPointData({ balance: 0, history: [] });
      }
    }
    loadPoints();
    return () => { mounted = false; };
  }, [currentUserId]);

  // ★ 일정 데이터 - 서버 API 연동
  const [schedules, setSchedules] = useState([]);
  const [scheduleData, setScheduleData] = useState({ today: [], upcoming: [] });
  
  useEffect(() => {
    let mounted = true;
    async function loadSchedules() {
      if (!currentUserId) {
        setSchedules([]);
        setScheduleData({ today: [], upcoming: [] });
        return;
      }
      try {
        const list = await scheduleService.getSchedules(currentUserId);
        if (mounted) {
          setSchedules(Array.isArray(list) ? list : []);
        }
      } catch (e) {
        console.error('[My] Failed to load schedules:', e);
        if (mounted) {
          setSchedules([]);
          setScheduleData({ today: [], upcoming: [] });
        }
      }
    }
    loadSchedules();
    
    const onUpdate = () => { loadSchedules(); };
    window.addEventListener('su:ssot:changed', onUpdate);
    return () => { 
      mounted = false; 
      window.removeEventListener('su:ssot:changed', onUpdate);
    };
  }, [currentUserId]);

  // Compute today/upcoming from schedules (pv2 pattern)
  useEffect(() => {
    const today = new Date();
    const pad = (n) => n.toString().padStart(2, '0');
    const todayStr = `${today.getFullYear()}-${pad(today.getMonth()+1)}-${pad(today.getDate())}`;
    const todayList = [];
    const upcomingList = [];
    (schedules || []).forEach(s => {
      if (!s || !s.scheduleDate) return;
      const scheduleObj = { id: s.id, title: s.title, time: s.scheduleTime || '', alarm: s.alarm || false, date: s.scheduleDate };
      if (s.scheduleDate === todayStr) todayList.push(scheduleObj);
      else if (s.scheduleDate > todayStr) upcomingList.push(scheduleObj);
    });
    todayList.sort((a,b) => (a.time||'') > (b.time||'') ? 1 : -1);
    upcomingList.sort((a,b) => (a.date||'') > (b.date||'') ? 1 : -1);
    setScheduleData({ today: todayList, upcoming: upcomingList });
  }, [schedules]);

  // Alarm functions (pv2 pattern)
  const clearAlarms = useCallback(() => {
    const timers = alarmTimersRef.current || {};
    Object.values(timers).forEach(t => clearTimeout(t));
    alarmTimersRef.current = {};
  }, []);

  const playAlarm = useCallback(async (title) => {
    try {
      if ("Notification" in window && Notification.permission === "granted") {
        new Notification('일정 알림', { body: title });
      } else if ("Notification" in window && Notification.permission !== "denied") {
        const perm = await Notification.requestPermission();
        if (perm === 'granted') new Notification('일정 알림', { body: title });
      }
    } catch (e) {}
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = 'sine';
      o.frequency.value = 880;
      o.connect(g);
      g.connect(ctx.destination);
      g.gain.value = 0.05;
      o.start();
      setTimeout(() => { o.stop(); ctx.close(); }, 800);
    } catch (e) {
      try { alert('일정 알림: ' + title); } catch (e) {}
    }
  }, []);

  const scheduleAlarms = useCallback(() => {
    clearAlarms();
    if (!alarmsEnabled) return;
    const now = new Date();
