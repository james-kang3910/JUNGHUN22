      // 상점 목록 다시 로드
      const shops = await storageAdapter.getMyShops();
      setMyShops(Array.isArray(shops) ? shops : []);
    } catch (e) {
      console.error('[My] Failed to save shop:', e);
      setToast({ open: true, message: '저장 실패', type: 'error' });
    }
  };

  // 상점 삭제
  const handleDeleteShop = async (shopId) => {
