{
  "name": "share-unity",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "install:server": "npm ci --prefix server",
    "build:production": "npm run build",
    "verify:deploy": "node tools/verify_deploy_build.js",
    "deploy:help": "node tools/deploy_for_team.js",
    "deploy:check": "node tools/pre_deploy_check.js",
    "prestart": "node tools/verify_deploy_build.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "e2e:auth-regions": "node tools/e2e_auth_regions_ssot.js",
    "e2e:broadcast": "node tools/e2e_broadcast_ssot.js",
    "e2e:shops": "node tools/e2e_shops_ssot.js",
    "e2e:qrpay": "node tools/e2e_qrpay_ssot.js",
    "e2e:payouts": "node tools/e2e_payouts_ssot.js",
    "e2e:supplies": "node tools/e2e_supplies_ssot.js",
    "e2e:missions": "node tools/e2e_missions_ssot.js",
    "e2e:all": "node tools/e2e_all_ssot.js"
  },
  "packageManager": "npm@9.8.1",
  "dependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.1.4",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "6.14.1",
    "sharp": "^0.33.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.6",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@vitest/ui": "^1.1.0",
    "concurrently": "^8.2.2",
    "jsdom": "^23.0.1",
    "vitest": "^1.1.0"
  }
}
