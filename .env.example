# Environment Configuration Template
# Copy this file to .env and fill in your values

# Node Environment
NODE_ENV=production

# Server Configuration
PORT=8787
HOST=0.0.0.0

# Database Configuration (choose one)
# PostgreSQL (recommended for production)
DATABASE_URL=postgres://username:password@localhost:5432/smi_db
# Or use SQLite (development/testing only)
# DATABASE_URL=

# SSL for PostgreSQL (if using cloud DB like Heroku/Railway)
DB_SSL=false

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://smi.ceo,https://www.smi.ceo

# Application URL (used for callbacks, emails, etc.)
APP_URL=https://smi.ceo
HOSTNAME=smi.ceo

# Frontend Build Variables (Vite)
# QR 링크/공개 링크 생성 시 우선 사용되는 실제 서비스 도메인
VITE_PUBLIC_SITE_URL=https://smi.ceo
# 프론트에서 API를 직접 호출할 때 사용할 베이스 URL (미설정 시 같은 도메인 /api 사용)
# VITE_API_URL=https://smi.ceo

# Session/Security
SESSION_SECRET=your-super-secret-key-change-this-in-production
JWT_SECRET=another-secret-key-for-jwt-tokens
JWT_EXPIRES_IN=7d

# Admin Password (IMPORTANT: Change this in production!)
ADMIN_PASSWORD=admin

# Backup Password (CRITICAL: Separate password for backup/restore operations)
# This provides an additional security layer for sensitive backup operations
BACKUP_PASSWORD=backup_secure_password_2026

# Email Configuration (if needed)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@smi.ceo
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@smi.ceo

# External API Keys (if needed)
# GOOGLE_MAPS_API_KEY=
# PAYMENT_API_KEY=
# CLOUD_STORAGE_KEY=

# Logging
LOG_LEVEL=info
LOG_FILE=/var/log/smi/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cache Configuration (Redis, if used)
# REDIS_URL=redis://localhost:6379
# CACHE_TTL=3600

# Railway will automatically inject these in production:
# DATABASE_URL (from PostgreSQL addon)
# PORT
# RAILWAY_ENVIRONMENT
