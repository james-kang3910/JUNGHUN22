# 운영 환경 예시
NODE_ENV=production
PORT=8787
DATABASE_URL=postgresql://user:password@host:port/dbname
QR_SECRET=운영용_시크릿
JWT_SECRET=운영용_시크릿
VITE_PUBLIC_SITE_URL=https://smi.ceo
VITE_APP_REGION_HOST=smi.ceo
# DNS(ulsan.smi.ceo) 연결 전까지 path — 연결 후 subdomain 으로 변경
VITE_REGION_URL_MODE=path
ALLOWED_ORIGINS=https://smi.ceo,https://www.smi.ceo
ALLOW_REGION_SUBDOMAINS=true
APP_REGION_HOST=smi.ceo

